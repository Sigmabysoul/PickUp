# PickUp Production Environment Variables
NODE_ENV=production
PORT=3001

# Database Configuration (PostgreSQL 16 / Neon)
# Replace with your Neon connection string:
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Senior Employee Security Configuration
# Master Passcode for any senior supervisor (defaults to pickup2026 if not set):
SUPERVISOR_PASSCODE=pickup2026

# Individual Senior Supervisor PINs (optional):
SUPERVISOR_1_PIN=1234
SUPERVISOR_2_PIN=5678
SUPERVISOR_3_PIN=9999

# Secret key for cryptographically signing 30-day session tokens:
AUTH_SECRET=your_super_secret_session_key_here